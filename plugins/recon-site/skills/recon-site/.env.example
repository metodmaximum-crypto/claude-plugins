# Скопируйте этот файл в ~/.recon-site/.env (Windows: %USERPROFILE%\.recon-site\.env)
# и заполните там. Сюда ключи не вписывать: при обновлении плагина папка заменяется.

# --- Яндекс ---------------------------------------------------------------
# Yandex Cloud, Search API: выдача + Wordstat. Роль search-api.executor.
YC_API_KEY=
YC_FOLDER_ID=

# OAuth-токен Яндекса — Метрика, если клиент дал доступ к счётчику. Опционально.
YANDEX_OAUTH_TOKEN=

# --- Google ---------------------------------------------------------------
# Custom Search JSON API. Внимание: это НЕ реальная выдача Google —
# другой индекс, нет локального пака. Реальная выдача — только режим браузера.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# PageSpeed Insights — скорость и Core Web Vitals. Бесплатно, ключ не обязателен,
# но без него быстро упрётесь в лимит.
PAGESPEED_KEY=
